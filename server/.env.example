# === LLM ===
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
LLM_MODEL=gpt-4o-mini
LLM_SMALL_MODEL=gpt-4o-mini

# === Telegram Client API (Telethon) ===
# Получить на https://my.telegram.org/apps
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_api_hash_here
TELEGRAM_SESSION_NAME=umniy_ali_session
TELEGRAM_BOT_TOKEN=123456:ABC-DEF... # для отправки уведомлений

# === База данных ===
DATABASE_URL=sqlite+aiosqlite:///./umniy_ali.db
# Для PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost/umniy_ali

# === Redis (кэш, очереди) ===
REDIS_URL=redis://localhost:6379/0

# === Сервер ===
HOST=0.0.0.0
PORT=8000
DEBUG=true

# === YouTube / Google Search (этап 2-3) ===
YOUTUBE_API_KEY=
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=
