# Скопируй этот файл как local.properties и замени SERVER_URL на адрес своего сервера

# Для локального теста на эмуляторе Android Studio:
SERVER_URL=http://10.0.2.2:8000/

# Для теста по Wi-Fi в локальной сети (замени IP на IP своего компьютера):
# SERVER_URL=http://192.168.1.100:8000/

# Для продакшн-сервера с HTTPS:
# SERVER_URL=https://your-server.example.com/
